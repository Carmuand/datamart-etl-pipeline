# Copia este archivo a .env y ajusta los valores:  cp .env.example .env

# --- PostgreSQL de metadatos de Airflow ---
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change_me_airflow
AIRFLOW_DB_NAME=airflow

# --- PostgreSQL analítico (data warehouse) ---
WAREHOUSE_USER=dwh_user
WAREHOUSE_PASSWORD=change_me_dwh
WAREHOUSE_DB=datamart_dwh
WAREHOUSE_HOST_PORT=5433

# --- Airflow ---
# Generar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=change_me_secret
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me_admin
AIRFLOW_ADMIN_EMAIL=admin@example.com

# --- Airflow Variables (parámetros operativos del pipeline) ---
VAR_SALES_CSV_PATH=/opt/airflow/data/raw/sales_transactions.csv
VAR_BATCH_SIZE=50000
VAR_MIN_VALID_PRICE=0
VAR_TARGET_TIMEZONE=UTC
